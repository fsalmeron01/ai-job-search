# Copy this file to deploy/.env and fill in your values.
# Never commit deploy/.env - it belongs next to your secrets, not in git.

# Required: your fork's clone URL.
# Public/HTTPS:  https://github.com/<you>/ai-job-search.git
# Private/token: https://<token>@github.com/<you>/ai-job-search.git
# Private/SSH:   git@github.com:<you>/ai-job-search.git  (also set SSH_PRIVATE_KEY_FILE below and mount your key)
REPO_URL=

# Optional but recommended, so commits made from inside the container are attributed to you.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Optional. If set, Claude Code authenticates from this key instead of
# prompting an interactive browser login on first `claude` run inside the
# container. Uses Console/API billing rather than a Pro/Max/Team session -
# see https://code.claude.com/docs/en/authentication for the tradeoffs.
ANTHROPIC_API_KEY=

# Optional. Only needed for SSH-based private-repo cloning - path INSIDE the
# container to a mounted deploy-key secret (see the commented volume line in
# docker-compose.yml). Leave unset if REPO_URL is public or uses an HTTPS token.
SSH_PRIVATE_KEY_FILE=
